{
  "name": "@qmediat.io/gemini-code-context-mcp",
  "version": "1.17.1",
  "mcpName": "io.github.qmediat/gemini-code-context-mcp",
  "description": "MCP server that gives Claude Code and other MCP hosts long-context memory of a codebase through Gemini's 1M-token window: `ask`/`code` send the scanned workspace with implicit caching by default or an explicit Context Cache on request; `ask_agentic` reads files on demand for repos beyond the limit.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "claude-code",
    "context-cache",
    "code-review",
    "codebase-qa",
    "long-context"
  ],
  "homepage": "https://www.qmediat.io/open-source",
  "bugs": {
    "url": "https://github.com/qmediat/gemini-code-context-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmediat/gemini-code-context-mcp.git"
  },
  "license": "MIT",
  "author": "Quantum Media Technologies <dev@qmediat.io> (https://www.qmediat.io)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gemini-code-context-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration",
    "lint": "biome check src test",
    "format": "biome format --write src test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
